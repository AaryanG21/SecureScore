# Fulcrum environment template.
#
# Copy to .env.local for development (git-ignored), or supply these as real
# environment variables / secrets in deployment. Never commit a filled-in
# copy of this file.
#
# The app validates all of this at boot (src/lib/env.ts) and refuses to
# start if anything is missing or too weak.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://fulcrum:change-me@localhost:5432/fulcrum?schema=public"

# Only needed when the migration user cannot create databases (some managed
# Postgres providers). Leave unset otherwise.
# SHADOW_DATABASE_URL=""

# ---------------------------------------------------------------------------
# Secrets — generate fresh values, never reuse these placeholders
#
#   openssl rand -base64 32
#
# Both must decode to exactly 32 bytes. Rotating JWT_SIGNING_KEY invalidates
# every active session. Rotating TOTP_ENCRYPTION_KEY makes existing TOTP
# secrets undecryptable — every user would have to re-enroll — so plan a
# migration before ever changing it.
# ---------------------------------------------------------------------------
JWT_SIGNING_KEY="REPLACE_ME_base64_32_bytes"
TOTP_ENCRYPTION_KEY="REPLACE_ME_base64_32_bytes"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Absolute origin, used for cookie Secure flag, CSRF origin checks, and the
# TOTP issuer label. Use https:// in any real deployment.
APP_ORIGIN="http://localhost:3000"
APP_NAME="Fulcrum"

NODE_ENV="development"

# ---------------------------------------------------------------------------
# Token lifetimes (seconds)
# ---------------------------------------------------------------------------
ACCESS_TOKEN_TTL_SECONDS="600"        # 10 minutes
REFRESH_TOKEN_TTL_SECONDS="604800"    # 7 days
MFA_PENDING_TTL_SECONDS="300"         # password -> 2FA window
REAUTH_TTL_SECONDS="300"              # step-up freshness for admin actions

# ---------------------------------------------------------------------------
# Lockout policy
# ---------------------------------------------------------------------------
MAX_FAILED_LOGINS="5"
LOCKOUT_BASE_SECONDS="900"            # doubles per failure past the threshold

# ---------------------------------------------------------------------------
# Pinned external tool — testssl.sh v3.2.4
# ---------------------------------------------------------------------------
TESTSSL_PATH="./vendor/testssl.sh/testssl.sh"
TESTSSL_TIMEOUT_MS="300000"           # 5 minutes, then the process is killed

# ---------------------------------------------------------------------------
# Proxy handling
#
# Set TRUST_PROXY_HEADERS to "true" ONLY when a reverse proxy you control
# sets X-Forwarded-For. When false (the default), the header is ignored
# entirely — a spoofable client IP would make per-IP rate limiting
# meaningless.
#
# TRUSTED_PROXY_HOPS is the number of proxies you actually run in front of
# this app, and it is required (>= 1) whenever TRUST_PROXY_HEADERS is true;
# the app refuses to start otherwise. X-Forwarded-For is a list that each
# hop appends to, so entries on the LEFT are whatever the client sent and
# entries on the RIGHT are what your infrastructure wrote. The client
# address is read this many places in from the right. Set it wrong and you
# either read a forgeable value or none at all.
#
#   one Caddy / nginx / ALB in front        -> 1
#   Cloudflare in front of that             -> 2
#
# With TRUST_PROXY_HEADERS="false" the client IP is recorded as null and
# per-account rate limiting carries the load. That is deliberate: there is
# no socket address available to a route handler in this runtime, so a
# guess would be worse than an absence.
# ---------------------------------------------------------------------------
TRUST_PROXY_HEADERS="false"
TRUSTED_PROXY_HOPS="0"

# ---------------------------------------------------------------------------
# Seeding (development only; the seed script refuses to run in production)
# ---------------------------------------------------------------------------
# SEED_ADMIN_EMAIL="you@example.com"
# SEED_ADMIN_PASSWORD=""
